[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:layers]
name = Controller -> Service -> Repository の一方向
type = layers
containers =
    app.modules.auth
    app.modules.projects
    app.modules.contents
    app.modules.publishing
layers =
    router
    service
    repository

[importlinter:contract:service-no-sqlalchemy]
name = Service は sqlalchemy を直接 import しない
type = forbidden
source_modules =
    app.modules.auth.service
    app.modules.projects.service
    app.modules.contents.service
    app.modules.publishing.service
forbidden_modules =
    sqlalchemy
    app.core.db
allow_indirect_imports = True

[importlinter:contract:service-no-fastapi]
name = Service は FastAPI を知らない
type = forbidden
source_modules =
    app.modules.auth.service
    app.modules.projects.service
    app.modules.contents.service
    app.modules.publishing.service
forbidden_modules =
    fastapi
    starlette

[importlinter:contract:core-independence]
name = core は modules を知らない
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules

[importlinter:contract:publishing-service-ports-only]
name = publishing の Service は外部 API の具体実装を知らない（ポートだけを知る）
type = forbidden
source_modules =
    app.modules.publishing.service
forbidden_modules =
    app.channels.qiita
    app.llm
    anthropic
    httpx

[importlinter:contract:jobs-call-services]
name = ジョブは Service を呼ぶ。Repository を直接叩かない
type = forbidden
source_modules =
    app.jobs
forbidden_modules =
    app.modules.auth.repository
    app.modules.projects.repository
    app.modules.contents.repository
    app.modules.publishing.repository
allow_indirect_imports = True
