# アプリ設定（Pydantic Settings が読む）
DATABASE_URL=postgresql+asyncpg://reverb:reverb@localhost:5432/reverb
# トークン署名などの秘密鍵。M0 実装時に用途を確定する（design.md §4）
SECRET_KEY=change-me-in-local
# 外部サービスのトークン（Qiita）を暗号化する Fernet 鍵。カンマ区切りで複数並べると、
# 先頭で暗号化し全部で復号を試す（鍵の差し替え用）。本番では必須。生成：
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=
# チャネル変換（Claude API）。キーは SDK が環境変数から読む
ANTHROPIC_API_KEY=
CONVERSION_MODEL=claude-opus-5-5
CONVERSION_EFFORT=medium
# 変換ジョブのワーカーを API と同じプロセスで動かすか（ADR-0017）
RUN_CONVERSION_WORKER=true
